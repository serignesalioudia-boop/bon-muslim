<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDegrees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark" />

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginVertical="16dp">

            <ImageView
                android:id="@+id/ivCompassBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_compass_face"
                android:contentDescription="Cadran" />

            <ImageView
                android:id="@+id/ivCompass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_compass_needle"
                android:contentDescription="Aiguille Qibla" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvQiblaAngle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</LinearLayout>
